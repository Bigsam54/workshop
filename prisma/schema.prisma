generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String   @unique
  role         String   @default("SECRETARY") // ADMIN | SECRETARY | TECH
  passwordHash String
  createdAt    DateTime @default(now())

  assignedJobs     JobCard[]       @relation("AssignedTech")
  statusLogChanges JobStatusLog[]
  inventoryMoves   InventoryMovement[]
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique
  email     String?
  location  String?
  createdAt DateTime @default(now())

  vehicles Vehicle[]
  jobCards JobCard[]
}

model Vehicle {
  id          Int      @id @default(autoincrement())
  customerId  Int
  plateNumber String   @unique
  make        String
  model       String
  year        Int
  createdAt   DateTime @default(now())

  customer Customer  @relation(fields: [customerId], references: [id])
  jobCards JobCard[]
}

model JobCard {
  id          Int       @id @default(autoincrement())
  jobCode     String    @unique
  customerId  Int
  vehicleId   Int
  assignedTo  Int?
  complaint   String
  diagnosis   String?
  workDone    String?
  status      String    @default("NEW") // NEW | DIAGNOSING | IN_PROGRESS | WAITING_PARTS | COMPLETED | PAID
  priority    String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  laborCost   Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  customer   Customer       @relation(fields: [customerId], references: [id])
  vehicle    Vehicle        @relation(fields: [vehicleId], references: [id])
  technician User?          @relation("AssignedTech", fields: [assignedTo], references: [id])
  statusLogs JobStatusLog[]
  jobParts   JobPart[]
  payment    Payment?
}

model JobStatusLog {
  id        Int      @id @default(autoincrement())
  jobId     Int
  status    String
  changedBy Int
  timestamp DateTime @default(now())

  job  JobCard @relation(fields: [jobId], references: [id])
  user User    @relation(fields: [changedBy], references: [id])
}

model Part {
  id           Int    @id @default(autoincrement())
  name         String
  sku          String @unique
  unitPrice    Float
  stockQty     Int    @default(0)
  lowStockLevel Int   @default(5)

  inventoryMovements InventoryMovement[]
  jobParts           JobPart[]
}

model InventoryMovement {
  id        Int      @id @default(autoincrement())
  partId    Int
  type      String   // IN | OUT | ADJUST
  qty       Int
  note      String?
  createdBy Int
  timestamp DateTime @default(now())

  part      Part @relation(fields: [partId], references: [id])
  createdByUser User @relation(fields: [createdBy], references: [id])
}

model JobPart {
  id        Int   @id @default(autoincrement())
  jobId     Int
  partId    Int
  qty       Int
  unitPrice Float

  job  JobCard @relation(fields: [jobId], references: [id])
  part Part    @relation(fields: [partId], references: [id])
}

model Payment {
  id        Int       @id @default(autoincrement())
  jobId     Int       @unique
  method    String    @default("CASH") // CASH | MOMO | BANK | SPLIT
  amount    Float
  status    String    @default("UNPAID") // UNPAID | PAID
  paidAt    DateTime?
  reference String?
  createdAt DateTime  @default(now())

  job JobCard @relation(fields: [jobId], references: [id])
}
