generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int                 @id @default(autoincrement())
  name             String
  username         String              @unique
  role             String              @default("SECRETARY")
  passwordHash     String
  createdAt        DateTime            @default(now())
  inventoryMoves   InventoryMovement[]
  assignedJobs     JobCard[]           @relation("AssignedTech")
  statusLogChanges JobStatusLog[]
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String    @unique
  email     String?
  location  String?
  createdAt DateTime  @default(now())
  jobCards  JobCard[]
  vehicles  Vehicle[]
}

model Vehicle {
  id                 Int       @id @default(autoincrement())
  customerId         Int
  plateNumber        String    @unique
  make               String
  model              String
  year               Int
  mileage            String?
  chassisNo          String?
  engineNo           String?
  createdAt          DateTime  @default(now())
  history            String?
  notes              String?
  previousWork       String?
  lastServiceDate    DateTime?
  lastServiceMileage Int?
  jobCards           JobCard[]
  customer           Customer  @relation(fields: [customerId], references: [id])
}

model JobCard {
  id                Int            @id @default(autoincrement())
  jobCode           String         @unique
  customerId        Int
  vehicleId         Int
  assignedTo        Int?
  complaint         String
  repairInstruction String?
  promisedDelivery  String?
  paymentType       String?        @default("CASH")
  receptionist      String?
  diagnosis         String?
  workDone          String?
  status            String         @default("NEW")
  priority          String         @default("MEDIUM")
  laborCost         Float          @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  completedAt       DateTime?
  technician        User?          @relation("AssignedTech", fields: [assignedTo], references: [id])
  customer          Customer       @relation(fields: [customerId], references: [id])
  vehicle           Vehicle        @relation(fields: [vehicleId], references: [id])
  jobParts          JobPart[]
  statusLogs        JobStatusLog[]
  payment           Payment?
}

model JobStatusLog {
  id        Int      @id @default(autoincrement())
  jobId     Int
  status    String
  changedBy Int
  timestamp DateTime @default(now())
  user      User     @relation(fields: [changedBy], references: [id])
  job       JobCard  @relation(fields: [jobId], references: [id])
}

model Part {
  id                 Int                 @id @default(autoincrement())
  name               String
  sku                String              @unique
  unitPrice          Float
  stockQty           Int                 @default(0)
  lowStockLevel      Int                 @default(5)
  inventoryMovements InventoryMovement[]
  jobParts           JobPart[]
}

model InventoryMovement {
  id            Int      @id @default(autoincrement())
  partId        Int
  type          String
  qty           Int
  previousQty   Int?
  newQty        Int?
  note          String?
  createdBy     Int
  timestamp     DateTime @default(now())
  createdByUser User     @relation(fields: [createdBy], references: [id])
  part          Part     @relation(fields: [partId], references: [id])
}

model JobPart {
  id        Int     @id @default(autoincrement())
  jobId     Int
  partId    Int
  qty       Int
  unitPrice Float
  job       JobCard @relation(fields: [jobId], references: [id])
  part      Part    @relation(fields: [partId], references: [id])
}

model Payment {
  id        Int       @id @default(autoincrement())
  jobId     Int       @unique
  method    String    @default("CASH")
  amount    Float
  status    String    @default("UNPAID")
  paidAt    DateTime?
  reference String?
  createdAt DateTime  @default(now())
  job       JobCard   @relation(fields: [jobId], references: [id])
}
